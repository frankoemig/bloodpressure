@startuml

class "**[[StructureDefinition-BloodPressure.html Blood Pressure]]**" as bp {
    identifier
    interpretation: code
    location: code
    positionOfBody: code
    positionOfArm: code
    method: code
    exertion: code|quantity
    consciousness: code
    tilt: integer
    recordedDateTime: instant
    performedDateTime: instant|period
    comment: string
}

package "Measurement" {
    abstract class "Blood Pressure Value" as bpv {
        value: integer
        unit = mm[Hg]
        referenceRange: range
        interpretation: code
    }

    class "Reference Range" as rr {
        low : integer
        high: integer
        age: range
    }
}

class "**Systolic BP**" as syst
class "**Diastolic BP**" as diast

abstract class "Device" as dev {
    type: code
    automated: boolean
    serialNumber: string|UDI
}

class "Cuff" as cuff {
    cuffType: code
    cuffSize: code
}

class "Catheter" as catheter {
    lumen: integer
}

dev <|-up- cuff
dev <|-up- catheter

package "Calculation (1 value)" as calc1 {
    class "Pulse Pressure" as pbp
    class "Mean Arterial Pressure" as mabp
}

mabp o.up. "0..1" syst
mabp o.up. "0..1" diast
pbp o.up. "0..1" syst
pbp o.up. "0..1" diast

package "Calculation (2 values)" as calc2 {
    abstract class "Culculation" as calcfct {
        count: integer
        start: instant
        end: instant
    }
    class "Ambulatory BP" as ambbp {
        duration: 24h
        interval: 10/15/20min
    }
    Note bottom of ambbp
    tracks automatically over a 24-hour period
    while subject goes about normal daily activities 
    and sleep
    end Note
    class "Average"
    class "Min"
    class "Max"

    calcfct <|-- ambbp
    calcfct <|-- "Average"
    calcfct <|-right- "Min"
    calcfct <|-left- "Max"
    ambbp o.right. "Average"
    Note on link 
    several averages
    for certain time periods
    end Note
}

calcfct o.. "0..*" bp

package "Other Relevant Concepts" as orc {
    class "Body Weight" as bw #cfc
    class "Medication" as med #cfc
    class "Exertion" as exer #cfc
    class "Pulse" as pulse #cfc

    Note "neccessary to \ninterpret \nthe measurement" as N1
}


package "Participation" {
    abstract class "Role" as rol #88f {
        type: code
    }
    class "Author" as a #88f
    class "Performer" as p #88f
    Note right of p
    normally a physician,
    but could also
    be the patient
    end Note
    class "Recorder" as r #88f

    class "Person" as pers #88f {
        identifier
        name
        gender
        dob
    }
    rol "0..*" -up- "0..1" pers
    rol "0..*" -- "0..1" dev

    class "Subject" as s #88f
    Note left of s
    normally
    the patient
    itself
    end Note

    s ... orc

    rol <|-- a
    rol <|-- p
    rol <|-- r
    rol <|-- s

    Note "some roles can either be played \nby a person or a device, \nbut the subject should be a person" as N2
}


bpv <|-up- syst
bpv <|-up- diast
bpv <|-down- mabp
bpv <|-down- pbp
bpv "1" *-right- "1" rr

bp <|-right- ambbp

bp -up- "0..1" a
bp -up- "0..1" p
bp -up- "0..1" r
bp -up- "1" s
bp -- "0..1" bw
bp -right- "0..1" exer
bp -right- "0..*" med
bp -right- "0..1" pulse
bp "1" -left- "1" dev

bp *-- "1" syst
bp *-- "0..1" diast

@enduml