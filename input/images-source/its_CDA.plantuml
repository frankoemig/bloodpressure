@startuml

title "Representation in CDA: ITS (Draft!)"

class "Clinical Document" as doc #fbb {
    classCode = DOCCLIN
    moodCode = EVN
    id
    status
    category
    code
    effectiveDateTime
    note
    bodySite
    method
}

class "hasComponent" as comp1 #f99 {
    typeCode = COMP
}

class "Participation" as part0 #8af {
    typeCode = RCT
}

doc --> "1" comp1
doc -right-> "0..1" part0

class "PatientRole" as role0 #ffb {
    classCode = PAT
}

part0 -right-> role0


class "Patient" as pat #bfb {
    classCode = PSN
    determinerCode = INST
    id
    name
    gender
    birthTime
}

role0 -right-> "1" pat

class "Structured Body" as body #fbb {
    classCode = DOCBODY
    moodCode = EVN
    id
    status
    category
    code
    effectiveDateTime
    note
    bodySite
    method
}

comp1 --> body

class "Section" as sect #fbb {
    classCode = DOCSECT
    moodCode = EVN
    code
    title
    text
}

class "hasComponent" as comp2 #f99 {
    typeCode = COMP
}

class "hasComponent" as comp3 #f99 {
    typeCode = COMP
}

body -right-> "1..*" comp2
comp2 -right-> sect

sect -right-> "1..*" comp3

class "Observation (for BP D-MIM)" as obs1 #fbb {
    classCode = OBS
    moodCode = EVN
    id
    status
    category
    code
    effectiveDateTime
    note
    bodySite
    method
}

comp3 -right-> obs1

circle "Entry Point" as ep1 #000
circle "Exit Point \nto include \nV3 model" as ep2 #000

doc <.. ep1
obs1 <.right. ep2

@enduml